# ===== 高德地图 Web服务 API =====
# 申请：lbs.amap.com 控制台 → 应用管理 → 创建应用 → 添加 Key（平台必须选「Web服务」）
# 不填则使用内置 mock 数据（闭环照常可跑）
AMAP_KEY=

# ===== LLM（模型）API =====
# 二选一（都填时按 LLM_PROVIDER 决定；默认 auto 优先 Anthropic）：
#   ANTHROPIC_API_KEY=sk-ant-...   Anthropic Claude（claude-opus-5）
#   DEEPSEEK_API_KEY=sk-...        DeepSeek（国内可直连，OpenAI 兼容）
# 都不填则使用内置规则抽取 + 模板推荐（mock 模式，闭环照常可跑）
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# provider: auto | anthropic | deepseek（auto=有哪个 key 用哪个）
LLM_PROVIDER=auto
DEEPSEEK_MODEL=deepseek-chat

# ===== 可选配置 =====
MODEL=claude-opus-5
MAX_TOKENS=16000

# 位置缺失时的兜底城市
DEFAULT_CITY=广州
DEFAULT_RADIUS=5000

# 本地软熔断（次/天）：高德真实配额是月配额（搜索组个人 5,000/月），此值仅防调试打爆
AMAP_SOFT_LIMIT=200

LOG_LEVEL=INFO
# 1/true/yes 时开启 LangSmith tracing（需安装 langsmith）
LANGSMITH_TRACING=false
